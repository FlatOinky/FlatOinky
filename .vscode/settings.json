{
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[javascript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"cSpell.words": ["fmmo", "Greasyfork", "oinky", "PHPSESSID", "Smittys"],
	"[html]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"tailwindCSS.classFunctions": [
		"((context.)?ui.)?el(.icon|.input|.tooltip)?.\\w*",
		"setupIconElement"
	],
	"tailwindCSS.experimental.configFile": "./src/renderer/src/styles.css"
}

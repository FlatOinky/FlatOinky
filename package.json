{
	"name": "flat-oinky",
	"version": "0.8.0",
	"description": "A desktop application for Flat MMO",
	"main": "./out/main/index.js",
	"author": "soggypiggy <dev@soggypiggy.com>",
	"homepage": "https://github.com/FlatOinky/FlatOinky",
	"desktopName": "io.github.flatoinky.FlatOinky.desktop",
	"scripts": {
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
		"start": "electron-vite preview",
		"dev": "electron-vite dev",
		"build": "pnpm run typecheck && electron-vite build",
		"postinstall": "electron-builder install-app-deps",
		"build:unpack": "pnpm run build && electron-builder --dir",
		"build:win": "pnpm run build && electron-builder --win && node build/copy_channel_files.mjs",
		"build:mac": "pnpm run build && electron-builder --mac && node build/copy_channel_files.mjs",
		"build:linux": "pnpm run build && electron-builder --linux && node build/copy_channel_files.mjs"
	},
	"dependencies": {
		"@dicebear/core": "^10.6.1",
		"@dicebear/styles": "^10.5.0",
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"dot-prop": "^10.2.0",
		"electron-log": "^5.4.4",
		"electron-updater": "^6.8.9",
		"fuse.js": "^7.5.0",
		"modern-tar": "^0.7.7"
	},
	"devDependencies": {
		"@date-fns/tz": "^1.5.0",
		"@date-fns/utc": "^2.1.1",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@iconify-json/tabler": "^1.2.38",
		"@iconify/tailwind4": "^1.2.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/mustache": "^4.2.6",
		"@types/node": "^22.20.1",
		"daisyui": "^5.7.19",
		"date-fns": "^4.4.0",
		"electron": "^41.10.6",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"mustache": "^4.2.0",
		"oxfmt": "^0.59.0",
		"oxlint": "^1.79.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.1"
	}
}
